# Vercel KV (Redis) credentials
# Get these from your Vercel project dashboard > Storage > KV
VERCEL_KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
VERCEL_KV_REST_API_TOKEN=your_kv_token_here

# WATI WhatsApp API
# Get from app.wati.io > API > API Keys
WATI_API_KEY=your_wati_api_key_here
WATI_API_ENDPOINT=https://live-mt-server.wati.io/your_instance_id

# Base URL for payment links in WhatsApp messages
BASE_URL=https://your-project.vercel.app

# Supervisor dashboard password (change this!)
SUPERVISOR_PASSWORD=admin123
